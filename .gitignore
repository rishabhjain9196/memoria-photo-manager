# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Build output (rebuild with .\build.ps1)
build/
dist/
*.spec

# Generated test library (rebuild with: .\.venv\Scripts\python tools\make_test_library.py)
test-library/

# Generated by tools/ui_screenshots.py and tools/benchmark.py when pointed inside the repo
shots/
memoria-bench/

# Created by Memoria itself inside any library or output folder
.memoria/
.memoria-work-*/
*.memoria-tmp
Memoria Exports/

# Archives and logs
*.zip
*.log

# Atomic diagnostic-report staging files; reviewed aggregate .json reports may be committed.
diagnostics/reports/.*.tmp

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
